# Bunny API Proxy Environment Configuration
# Copy this file to .env and customize for your deployment.
# These are all the variables the proxy reads (internal/config/config.go).

# REQUIRED: bunny.net master API key
# Get this from your bunny.net dashboard: https://dash.bunny.net
# Used for: upstream API calls to bunny.net and bootstrap authentication
# (creating the first admin token). Locked for the admin API once an admin
# token exists.
# MUST be kept secret: never commit a real .env to version control.
BUNNY_API_KEY=your-bunny-net-api-key

# Log level: debug, info, warn, error (default: info)
# Use 'info' for production, 'debug' only for troubleshooting.
# WARNING: 'debug' logs full request/response bodies. Never use it in production.
LOG_LEVEL=info

# Address the proxy listens on (default: ":8080", all interfaces, port 8080)
# Behind a reverse proxy ":8080" is fine; the published port is set in docker-compose.yml.
LISTEN_ADDR=:8080

# Path to the SQLite database file (default: /data/proxy.db)
# In Docker: /data/proxy.db (matches the volume mount)
# On bare metal: for example /var/lib/bunny-api-proxy/proxy.db
DATABASE_PATH=/data/proxy.db

# Address of the Prometheus metrics listener (default: "localhost:9090")
# Localhost only by default, so metrics are not exposed externally.
METRICS_LISTEN_ADDR=localhost:9090

# Optional: bunny.net API base URL override (default: https://api.bunny.net)
# Useful for testing against a mock server.
# BUNNY_API_URL=https://api.bunny.net
